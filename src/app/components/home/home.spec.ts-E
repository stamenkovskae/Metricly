import { TestBed } from '@angular/core/testing';
import { provideRouter } from '@angular/router';
import { Observable, Subject, of, throwError } from 'rxjs';
import { vi } from 'vitest';
import { stubLocalStorage } from '../../dashboards/fake-storage';
import { DashboardStore } from '../../dashboards/dashboard-store';
import { ChartQuery } from '../../query/chart-query';
import { QueryApi, QueryResponse } from '../../query/query-api';
import { QueryState } from '../builder/query-state';
import { PRESETS } from '../suggestions/presets';
import { HomeComponent } from './home.component';
import { recipeId } from './recipe-id';

const query: ChartQuery = { metric: 'requests', speed: 'second', filters: [], look: 'line', rangeMinutes: 30 };

describe('Home', () => {
  const setup = (run: () => Observable<QueryResponse>) => {
    TestBed.configureTestingModule({
      imports: [HomeComponent],
      providers: [provideRouter([]), { provide: QueryApi, useValue: { run: vi.fn(run) } }],
    });
    const fixture = TestBed.createComponent(HomeComponent);
    fixture.detectChanges();
    return { fixture, el: fixture.nativeElement as HTMLElement, store: TestBed.inject(DashboardStore) };
  };
  const ok = () => of({ promql: '', series: [] });
  beforeEach(stubLocalStorage);

  it('starts fresh: three open steps, an empty-state for dashboards, a link per recipe', () => {
    const { el } = setup(ok);
    expect(el.textContent).toContain('Make your first chart');
    expect(el.textContent).toContain('Connected. Prometheus is answering.');
    expect(el.textContent).toContain('No dashboards yet');
    expect(el.querySelectorAll('li.done')).toHaveLength(1);
    const links = [...el.querySelectorAll<HTMLAnchorElement>('a.recipe')].map((a) => a.getAttribute('href'));
    expect(links).toEqual(PRESETS.map((p) => `/builder?recipe=${recipeId(p.name)}`));
  });

  it('shows a skeleton while checking, then the hint when Prometheus does not answer', () => {
    const pending = new Subject<QueryResponse>();
    const { fixture, el } = setup(() => pending);
    expect(el.querySelector('.skeleton')).toBeTruthy();
    pending.error(new Error('nope'));
    fixture.detectChanges();
    expect(el.querySelector('.skeleton')).toBeNull();
    expect(el.textContent).toContain("Prometheus isn't answering.");
    expect(el.textContent).toContain('docker compose up -d prometheus');
  });

  it('can check again after a failure', () => {
    let fail = true;
    const { fixture, el } = setup(() => (fail ? throwError(() => new Error('x')) : ok()));
    fail = false;
    el.querySelector<HTMLButtonElement>('button.act')!.click();
    fixture.detectChanges();
    expect(el.textContent).toContain('Connected.');
  });

  it('ticks off steps from the store and collapses once everything is done', () => {
    const { fixture, el, store } = setup(ok);
    store.save('Requests', query, { name: 'Checkout' });
    fixture.detectChanges();
    expect(el.querySelector('.steps')).toBeNull();
    expect(el.textContent).toContain('Checkout');
    expect(el.textContent).toContain('1 chart');
    el.querySelector<HTMLButtonElement>('button.link')!.click();
    fixture.detectChanges();
    expect(el.querySelectorAll('li.done')).toHaveLength(3);
  });

  it('counts a chart built this session as step two', () => {
    const { fixture, el } = setup(ok);
    TestBed.inject(QueryState).load(query);
    fixture.detectChanges();
    expect([...el.querySelectorAll('li.done strong')].map((s) => s.textContent?.trim())).toContain('Done: Make your first chart');
  });

  it('keeps the panel open while the connection is broken, even with a saved dashboard', () => {
    const { fixture, el, store } = setup(() => throwError(() => new Error('x')));
    store.save('Requests', query, { name: 'Checkout' });
    fixture.detectChanges();
    expect(el.querySelector('.steps')).toBeTruthy();
  });
});
